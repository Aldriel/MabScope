<?xml version="1.0" encoding="UTF-8"?>

<!--
  "Antibody" tab: sequences of the chains, then their regions (FR, CDR, constant), an annotated
  view of the sequences and the liabilities. Texts are message keys (see main-view.fxml).
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="8" styleClass="tab-content"
      fx:controller="com.bioinfo.mabscope.desktop.controller.AntibodyTabController">

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="antibody.name"/>
        <TextField fx:id="nameField" promptText="antibody.name.prompt" prefColumnCount="16"/>
        <Label text="antibody.scheme"/>
        <ComboBox fx:id="schemeBox">
            <tooltip><Tooltip text="tip.scheme"/></tooltip>
        </ComboBox>
        <Button fx:id="analyzeButton" text="antibody.analyze" defaultButton="true"
                styleClass="primary-button" onAction="#onAnalyze"/>
        <MenuButton text="antibody.examples">
            <items>
                <MenuItem text="Trastuzumab" onAction="#onTrastuzumab"/>
                <MenuItem text="Adalimumab" onAction="#onAdalimumab"/>
            </items>
            <tooltip><Tooltip text="tip.examples"/></tooltip>
        </MenuButton>
        <Button text="antibody.demo" onAction="#onDemo">
            <tooltip><Tooltip text="tip.demo"/></tooltip>
        </Button>
        <Button text="?" styleClass="help-button" onAction="#onHelp">
            <tooltip><Tooltip text="tip.tabHelp"/></tooltip>
        </Button>
    </HBox>

    <HBox spacing="10" prefHeight="130" minHeight="90">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="antibody.heavy"/>
            <TextArea fx:id="heavyArea" promptText="antibody.heavy.prompt" wrapText="true"
                      styleClass="sequence-input" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="antibody.light"/>
            <TextArea fx:id="lightArea" promptText="antibody.light.prompt" wrapText="true"
                      styleClass="sequence-input" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

    <Label fx:id="summaryLabel" styleClass="summary" wrapText="true"/>

    <SplitPane fx:id="resultsSplit" dividerPositions="0.5" VBox.vgrow="ALWAYS">
        <SplitPane orientation="VERTICAL" dividerPositions="0.45">
            <ScrollPane fx:id="sequenceScroll" fitToWidth="true" styleClass="sequence-pane">
                <VBox fx:id="sequenceBox" spacing="10" styleClass="sequence-view"/>
            </ScrollPane>
            <TableView fx:id="regionTable">
                <placeholder><Label text="antibody.placeholder" wrapText="true"/></placeholder>
                <columns>
                    <TableColumn fx:id="regionChainColumn" text="column.chain" prefWidth="100"/>
                    <TableColumn fx:id="regionNameColumn" text="column.region" prefWidth="80"/>
                    <TableColumn fx:id="regionPositionsColumn" text="column.positions"
                                 prefWidth="85"/>
                    <TableColumn fx:id="regionLengthColumn" text="column.length" prefWidth="65"/>
                    <TableColumn fx:id="regionSequenceColumn" text="column.sequence"
                                 prefWidth="260"/>
                </columns>
            </TableView>
        </SplitPane>
        <VBox spacing="6">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="antibody.liabilities" styleClass="bold"/>
                <CheckBox fx:id="cdrOnlyBox" text="antibody.cdrOnly">
                    <tooltip><Tooltip text="tip.cdrOnly"/></tooltip>
                </CheckBox>
                <ComboBox fx:id="riskFilterBox">
                    <tooltip><Tooltip text="tip.riskFilter"/></tooltip>
                </ComboBox>
            </HBox>
            <TableView fx:id="liabilityTable" VBox.vgrow="ALWAYS">
                <placeholder><Label text="antibody.placeholder" wrapText="true"/></placeholder>
                <columns>
                    <TableColumn fx:id="liabilityChainColumn" text="column.chain"
                                 prefWidth="100"/>
                    <TableColumn fx:id="liabilitySiteColumn" text="column.site" prefWidth="65"/>
                    <TableColumn fx:id="liabilityTypeColumn" text="column.type" prefWidth="150"/>
                    <TableColumn fx:id="liabilityMotifColumn" text="column.motif"
                                 prefWidth="65"/>
                    <TableColumn fx:id="liabilityRegionColumn" text="column.region"
                                 prefWidth="80"/>
                    <TableColumn fx:id="liabilityRiskColumn" text="column.risk" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>
    </SplitPane>
</VBox>

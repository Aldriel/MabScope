<?xml version="1.0" encoding="UTF-8"?>

<!--
  "Peptide map" tab: digestion settings, theoretical peptides and the modified forms of the
  selected peptide. Texts are message keys (see main-view.fxml).
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="8" styleClass="tab-content"
      fx:controller="com.bioinfo.mabscope.desktop.controller.PeptideMapTabController">

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="map.protease"/>
        <ComboBox fx:id="proteaseBox"/>
        <Label text="map.missedCleavages"/>
        <Spinner fx:id="missedSpinner" prefWidth="70" min="0" max="5" initialValue="1"
                 editable="true">
            <tooltip><Tooltip text="tip.missedCleavages"/></tooltip>
        </Spinner>
        <Label text="map.length"/>
        <Spinner fx:id="minLengthSpinner" prefWidth="75" min="1" max="100" initialValue="1"
                 editable="true"/>
        <Label text="–"/>
        <Spinner fx:id="maxLengthSpinner" prefWidth="75" min="1" max="500" initialValue="60"
                 editable="true"/>
        <CheckBox fx:id="alkylatedBox" text="map.alkylated" selected="true">
            <tooltip><Tooltip text="tip.alkylated"/></tooltip>
        </CheckBox>
        <Button fx:id="digestButton" text="map.digest" styleClass="primary-button"
                onAction="#onDigest"/>
        <Button text="?" styleClass="help-button" onAction="#onHelp">
            <tooltip><Tooltip text="tip.tabHelp"/></tooltip>
        </Button>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <CheckBox fx:id="liabilitiesOnlyBox" text="map.liabilitiesOnly"/>
        <Separator orientation="VERTICAL"/>
        <Label fx:id="summaryLabel" styleClass="summary"/>
    </HBox>

    <SplitPane orientation="VERTICAL" dividerPositions="0.68" VBox.vgrow="ALWAYS">
        <TableView fx:id="peptideTable">
            <placeholder><Label text="map.placeholder" wrapText="true"/></placeholder>
            <columns>
                <TableColumn fx:id="chainColumn" text="column.chain" prefWidth="95"/>
                <TableColumn fx:id="positionsColumn" text="column.positions" prefWidth="85"/>
                <TableColumn fx:id="sequenceColumn" text="column.peptide" prefWidth="250"/>
                <TableColumn fx:id="missedColumn" text="column.missed" prefWidth="60"/>
                <TableColumn fx:id="massColumn" text="column.mass" prefWidth="105"/>
                <TableColumn fx:id="regionsColumn" text="column.regions" prefWidth="120"/>
                <TableColumn fx:id="liabilitiesColumn" text="column.liabilities"
                             prefWidth="230"/>
            </columns>
        </TableView>
        <VBox spacing="4">
            <Label fx:id="formsLabel" text="map.forms" styleClass="bold"/>
            <TableView fx:id="formTable" VBox.vgrow="ALWAYS">
                <placeholder><Label text="map.forms.placeholder" wrapText="true"/></placeholder>
                <columns>
                    <TableColumn fx:id="formSiteColumn" text="column.site" prefWidth="70"/>
                    <TableColumn fx:id="formTypeColumn" text="column.type" prefWidth="150"/>
                    <TableColumn fx:id="formModificationColumn" text="column.modification"
                                 prefWidth="120"/>
                    <TableColumn fx:id="formMassColumn" text="column.mass" prefWidth="105"/>
                    <TableColumn fx:id="formDeltaColumn" text="column.delta" prefWidth="95"/>
                    <TableColumn fx:id="formProFormaColumn" text="column.proForma"
                                 prefWidth="330"/>
                </columns>
            </TableView>
        </VBox>
    </SplitPane>
</VBox>
